#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

$envFile = dirname(__DIR__) . '/.env';
if (file_exists($envFile) && class_exists(\Dotenv\Dotenv::class)) {
    $dotenv = \Dotenv\Dotenv::createImmutable(dirname(__DIR__));
    $dotenv->safeLoad();
}

use App\CLI\QueueWorker;
use App\CLI\QueueRetry;
use App\CLI\QueueFlush;
use App\CLI\QueueFailed;
use App\CLI\QueueStats;
use App\CLI\QueuePrune;
use App\CLI\AuditLogs;
use App\CLI\Seeder;
use App\CLI\DevServer;
use App\CLI\MakeDb;
use App\CLI\PromoteStudents;
use App\CLI\Migrate;

$commands = [
    'db:seed'          => Seeder::class,
    'serve'            => DevServer::class,
    'make:db'          => MakeDb::class,
    'promote:students' => PromoteStudents::class,
    'queue:work'       => QueueWorker::class,
    'queue:retry'      => QueueRetry::class,
    'queue:flush'      => QueueFlush::class,
    'queue:failed'     => QueueFailed::class,
    'queue:stats'      => QueueStats::class,
    'queue:prune'      => QueuePrune::class,
    'audit:logs'       => AuditLogs::class,
    'migrate'          => Migrate::class,
    'make:controller'  => \App\CLI\MakeController::class,
    'make:model'       => \App\CLI\MakeModel::class,
    'make:migration'   => \App\CLI\MakeMigration::class,
];

$commandName = $argv[1] ?? null;
$args = array_slice($argv, 2);

if (!$commandName || !isset($commands[$commandName])) {
    echo "\033[33mAvailable commands:\033[0m\n";
    foreach ($commands as $cmd => $class) {
        echo " - {$cmd}\n";
    }
    exit(1);
}

$commandClass = $commands[$commandName];
$command = new $commandClass($args);
$command->handle($args);
