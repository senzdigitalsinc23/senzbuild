{
    "openapi": "3.0.0",
    "info": {
        "title": "API Project Specification",
        "description": "A comprehensive API for managing business operations.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api/v1",
