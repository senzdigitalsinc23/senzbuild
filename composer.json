{
    "name": "senzdigitals/framework",
    "description": "A custom PHP framework for personal projects",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.9",
        "firebase/php-jwt": "^7.0.4",
        "phpmailer/phpmailer": "^6.10",
        "twilio/sdk": "^8.7",
        "tecnickcom/tcpdf": "^6.10",
        "phpoffice/phpword": "^1.3",
        "phpoffice/phpspreadsheet": "^5.0",
        "stripe/stripe-php": "^17.5",
        "paypal/rest-api-sdk-php": "^1.6",
        "zircote/swagger-php": "^5.7",
        "guzzlehttp/psr7": "^2.12",
        "psr/http-server-middleware": "*",
        "psr/event-dispatcher": "*",
        "psr/cache": "*"
    },
    "authors": [
        {
            "name": "Douglas Senzu",
            "email": "senzdigitals.inc23@gmail.com"
        }
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "App\\Core\\": "Core/",
            "Database\\":"Database/",
            "Services\\": "Services/",
            "Support\\" : "Support/",
            "Repositories\\": "Repositories/",
            "Models\\": "Models/",
            "Jobs\\": "jobs/"
        },
        "files": [
            "Core/helpers.php"
        ]       
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php bin/console serve",
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage --coverage-clover coverage/clover.xml",
        "lint": "vendor/bin/phpcs --standard=PSR12 App/ Core/ Database/ Services/ Support/ Repositories/",
        "analyse": "vendor/bin/phpstan analyse",
        "security-audit": "composer audit",
        "migrate": "php tools/run_migrations.php",
        "docs": "vendor/bin/phpdoc -d src -t docs/api"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.0",
        "phpstan/phpstan": "*",
        "vimeo/psalm": "*",
        "fakerphp/faker": "1.24"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
