# Application Configuration
APP_NAME="SENZ DIGITAL SOLUTIONS"
APP_URL=http://localhost:8000
APP_ENV=development
APP_DEBUG=false

SUPPORT_EMAIL=senzdigitals.inc23@gmail.com
SUPPORT_PHONE=0240561313

# Rate Limiting
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW=2000

# CORS Configuration
CORS_ALLOWED_ORIGINS=""

# API Configuration
API_KEY=
API_SECRET=

# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=basturms_db
DB_USER=root
DB_PASS=tem22ple12345?
DB_DRIVER=mysql

# Security Configuration
# CRITICAL: Generate a strong JWT secret before deploying to production
# Generate using: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Email Service Configuration
MAIL_HOST=smtp.gmail.com
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_NAME=""
MAIL_PORT=465
MAIL_ENCRYPTION=ssl 

# SMS Service Configuration
SMS_ID=your-sms-id
TOKEN=your-sms-token
SMS_FROM=your-sms-sender

# MoMo Sandbox Keys MTN
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com/collection/v1_0
MOMO_PRIMARY_KEY=your_api_key
MOMO_USER_ID=your_generated_user_id
MOMO_CALLBACK_URL=http://127.0.0.1/webhook/momo
MOMO_CURRENCY=GHS

# HUBTEL (Vodafone & AirtelTigo)
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_secret
HUBTEL_CALLBACK_URL=https://yourdomain.com/webhook/hubtel

# PAYSTACK (Optional Ghana MoMo support)
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://yourdomainname/webhook/paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS

# Brute Force Protection
BRUTE_FORCE_MAX=5
BRUTE_FORCE_LOCKOUT=900

# Cache Configuration
CACHE_DRIVER=file
CACHE_TTL=3600

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=daily
LOG_MAX_FILES=7

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

DEV_INFO="senz digital solutions"
DEV_CONTACT=0240561313


# Inventory API Configuration
INVENTORY_API_URL=http://localhost:8000/api/v1
INVENTORY_API_KEY=devKey123
INVENTORY_API_TIMEOUT=30

# Payment Gateway Configuration
PAYMENT_PROVIDER=paystack
PAYMENT_GATEWAY_TIMEOUT=30

# Accounting API Configuration
ACCOUNTING_API_URL=http://localhost:8000/api/v1
ACCOUNTING_API_KEY=devKey123
ACCOUNTING_API_TIMEOUT=30

# Production Settings (uncomment for production)
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE=true
# LOG_LEVEL=error

# Backup Encryption - A random 64-char hex string; generate with: php -r "echo bin2hex(random_bytes(32));"
BACKUP_ENCRYPTION_KEY=
